# ASTROVERSE Environment Variables Configuration

# Server & Security
PORT=3000
JWT_SECRET=astroverse_celestial_sacred_jwt_secret_key_2026

# AI Engine Integration (Optional)
# If provided, Astroverse AI routes requests through Google Gemini or OpenAI.
# If omitted, Astroverse automatically runs its built-in, context-aware Vedic Jyotish reasoning engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Razorpay Payment Gateway (Optional)
# If provided, calls live Razorpay order creation and HMAC-SHA256 signature verification.
# If omitted, Astroverse runs in transparent Sandbox Test Mode allowing seamless membership testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
